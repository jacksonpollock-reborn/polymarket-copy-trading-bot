# Copy to .env and fill in. Never commit the real file.

# Wallet used to sign CLOB orders (only exercised when PAPER_TRADE is flipped to false)
WALLET_PRIVATE_KEY=your-private-key-here

# Polymarket CLOB API credentials
CLOB_API_KEY=your-clob-api-key-here
CLOB_API_SECRET=your-clob-api-secret-here
CLOB_API_PASSPHRASE=your-clob-api-passphrase-here

# Polygon RPC (e.g. Alchemy). The listener rewrites wss:// to https:// and polls over HTTP.
POLYGON_WSS_RPC=wss://polygon-mainnet.g.alchemy.com/v2/your-alchemy-key-here

# Telegram bot used for trade alerts and the confirm button
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Shared secret between the crawler and the whitelist server (x-api-key header)
INTERNAL_API_KEY=choose-a-long-random-string

# Datastores (hostnames match docker-compose.yml service names; change the password for any real deployment)
DATABASE_URL=postgres://bot:botpass@postgres:5432/copybot
REDIS_URL=redis://redis:6379

# Optional: set automatically for the crawler container by docker-compose.yml
# WHITELIST_URL=http://whitelist:3000
